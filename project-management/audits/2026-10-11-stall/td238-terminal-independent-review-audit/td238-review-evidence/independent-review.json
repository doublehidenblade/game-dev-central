  "findings": [
    {
      "id": "IR1-rapid-reopen-focus",
      "severity": "P2",
      "criterion": "T3",
      "path": "godot/scripts/lower_city/debug_terminal_panel.gd",
      "lines": [
        60,
        61
      ],
      "description": "open_terminal overwrites _previous_focus from current viewport focus even when reopening before the deferred restoration has run. Closing hides the old editor and current focus becomes null, so an immediate reopen erases the original live sentinel target. Final close leaves focus null.",
      "reproduction": "sentinel focus -> open_terminal(1) -> await frames -> close_terminal() -> open_terminal(1) in the same tick -> await frames -> close_terminal() -> await frames",
      "observed": "focus null; expected original still-valid fixture.sentinel",
      "evidence": [
        "focus-probe.txt",
        "focus-probe/execution.json",
        "focus-probe-native/execution.json"
      ],
      "coverage_gap": "test_terminal_component.gd:153-160 checks focus while rapid toggles are open, then explicitly re-grabs the sentinel rather than asserting restoration after the final close."
    },
    {
      "id": "IR2-parent-focus",
      "severity": "P2",
      "criterion": "T3",
      "path": "godot/scripts/lower_city/debug_terminal_panel.gd",
      "lines": [
        202,
        204
      ],
      "description": "The open boundary explicitly permits current == boundary, but restore requires boundary.is_ancestor_of(target), which is false for the boundary itself. A valid focusable parent therefore opens successfully and loses focus on close.",
      "reproduction": "fixture.focus_mode = Control.FOCUS_ALL; fixture.grab_focus(); open_terminal(1); await frames; close_terminal(); await frames",
      "observed": "open true; final focus null; expected same live fixture parent",
      "evidence": [
        "focus-probe.txt",
        "focus-probe/execution.json",
        "focus-probe-native/execution.json"
      ]
    },
